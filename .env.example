# Docker Compose settings (copy to .env). Never commit the real .env.

# Generate with: docker compose run --rm --no-deps migrate php artisan key:generate --show
APP_KEY=
APP_URL=http://localhost:8080
# Use "staging" to allow seeding demo data (php artisan db:seed is refused in production).
APP_ENV=production
MASROOF_HTTP_PORT=8080
# Set to true when served over HTTPS.
MASROOF_COOKIE_SECURE=false

DB_DATABASE=masroof
DB_USERNAME=masroof
DB_PASSWORD=change-me

REDIS_PASSWORD=change-me-too

# log (default) or smtp
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@masroof.app

# tesseract (free, local) or mock
MASROOF_OCR_DRIVER=tesseract
